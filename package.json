{
  "name": "wasteland-hunter",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "build:next": "node scripts/build-next.mjs",
    "android:sync": "npm run build:next && cap sync android",
    "test": "node --test tests/migration.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:visual": "node tests/visual-rustport.mjs",
    "test:route": "node tests/route-rustport.mjs",
    "test:next": "node tests/next-runtime.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:shared": "node --test tests/shared-contract.test.mjs",
    "test:route:data": "node --test tests/route-data.test.mjs",
    "test:movement": "node --test tests/movement.test.mjs",
    "test:spatial": "node --test tests/spatial-sandbox.test.mjs",
    "test:spatial:browser": "node tests/spatial-sandbox-browser.mjs",
    "validate:project": "python3 scripts/validation/validate_project.py",
    "validate:ids": "python3 scripts/validation/validate_ids.py",
    "validate:world-state": "python3 scripts/validation/validate_world_state.py",
    "validate:save": "python3 scripts/validation/validate_save.py",
    "validate:references": "python3 scripts/validation/validate_references.py",
    "validate:versions": "python3 scripts/validation/validate_versions.py",
    "validate:save-compatibility": "python3 scripts/validation/validate_save_compatibility.py",
    "assets:validate": "python3 scripts/assets/validate_assets.py",
    "assets:maps": "python3 scripts/assets/validate_maps.py",
    "assets:vehicle": "python3 scripts/assets/validate_vehicle_mounts.py",
    "assets:release": "python3 scripts/assets/build_release_manifest.py"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
